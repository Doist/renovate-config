{
  "extends": [
    "github>doist/renovate-config:doist-base"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^com\\.(doist|todoist)[.:]/"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "groupName": "org.jetbrains.kotlin.*",
      "matchPackagePrefixes": [
        "org.jetbrains.kotlin:",
        "org.jetbrains.kotlin.",
        "com.google.devtools.ksp"
      ]
    },
    {
      "groupName": "org.jetbrains.kotlinx.*",
      "matchPackagePrefixes": [
        "org.jetbrains.kotlinx:",
        "org.jetbrains.kotlinx."
      ]
    },
    {
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-datetime"],
      "allowedVersions": "!/-0\\.6\\.x-compat$/"
    },
    {
      "groupName": "org.jetbrains.kotlin-wrappers:*",
      "matchPackagePrefixes": [
        "org.jetbrains.kotlin-wrappers:"
      ]
    },
    {
      "groupName": "detekt",
      "matchPackagePrefixes": [
        "dev.detekt",
        "io.gitlab.arturbosch.detekt"
      ]
    }
  ]
}
